{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Payments": {
    "Enabled": true,
    "Provider": "WSPay",
    "WSPay": {
      "Environment": "Sandbox",
      "UseMinorUnits": false,
      // SECURITY: The following credentials should be provided via environment variables, user secrets, or secure configuration management (e.g., Azure Key Vault).
      // These values must NEVER be committed with actual credentials.
      "MerchantId": "",
      "StoreId": "",
      "ApiKey": "",
      "ApiSecret": "",
      "Currency": "RSD",
      "ReturnUrlSuccess": "/payments/wspay/return/success",
      "ReturnUrlCancel": "/payments/wspay/return/cancel",
      "WebhookSecret": "",
      "SignatureAlgorithm": "HMAC-SHA256"
    }
  },

