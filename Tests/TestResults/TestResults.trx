info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (0ms) [Parameters=[@__p_1='?' (DbType = Int32), @__p_0='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT "p"."product_id" AS "Id", "p"."name" AS "Name", "p"."input_dt" AS "InputDt", "p"."is_active" AS "IsActive", COALESCE((&#xD;
          SELECT COALESCE(SUM("p1"."qty_on_hand"), 0)&#xD;
          FROM "product_variant" AS "p0"&#xD;
          INNER JOIN "product_inventory" AS "p1" ON "p0"."product_variant_id" = "p1"."product_variant_id"&#xD;
          WHERE NOT ("p0"."is_deleted") AND "p0"."product_id" = "p"."product_id" AND "p0"."is_active" AND NOT ("p1"."is_deleted") AND "p1"."store_id" = 1 AND "p1"."is_active"), 0) AS "QtyStore1", COALESCE((&#xD;
          SELECT COALESCE(SUM("p3"."qty_on_hand"), 0)&#xD;
          FROM "product_variant" AS "p2"&#xD;
          INNER JOIN "product_inventory" AS "p3" ON "p2"."product_variant_id" = "p3"."product_variant_id"&#xD;
          WHERE NOT ("p2"."is_deleted") AND "p2"."product_id" = "p"."product_id" AND "p2"."is_active" AND NOT ("p3"."is_deleted") AND "p3"."store_id" = 2 AND "p3"."is_active"), 0) AS "QtyStore2", "p"."stamp" AS "Stamp"&#xD;
      FROM "product" AS "p"&#xD;
      WHERE "p"."product_id" &gt; 0 AND NOT ("p"."is_deleted")&#xD;
      ORDER BY "p"."product_id"&#xD;
      LIMIT @__p_1 OFFSET @__p_0&#xD;
